/* Styles for the harbor HUD and the cargo screen. Built in code by HarborGame and CargoScreen. */

.harbor-root {
    flex-grow: 1;
}

/* HUD */

.hud {
    position: absolute;
    top: 12px;
    left: 12px;
    max-width: 420px;
    padding: 10px 14px;
    border-radius: 8px;
    background-color: rgba(20, 24, 30, 0.72);
    color: rgb(242, 242, 242);
    font-size: 13px;
}

.hud > Label {
    white-space: normal;
}

.hud-status {
    color: rgb(255, 225, 184);
}

.hud-help {
    margin-top: 6px;
    color: rgb(200, 208, 216);
}

.prompt {
    position: absolute;
    bottom: 32px;
    align-self: center;
    padding: 10px 18px;
    border-radius: 20px;
    background-color: rgba(20, 24, 30, 0.8);
    color: rgb(255, 255, 255);
    font-size: 16px;
}

/* Cargo screen */

.cargo-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background-color: rgba(15, 18, 22, 0.55);
}

.cargo-panel {
    width: 100%;
    max-width: 1024px;
    max-height: 100%;
    padding: 20px 24px;
    border-radius: 12px;
    background-color: rgb(245, 236, 217);
    color: rgb(45, 36, 24);
    font-size: 15px;
}

.cargo-panel Label {
    white-space: normal;
    color: rgb(45, 36, 24);
}

.cargo-panel Button {
    margin: 0;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(45, 36, 24);
    background-color: rgb(255, 255, 255);
    color: rgb(45, 36, 24);
}

.cargo-panel Button:hover {
    background-color: rgb(255, 243, 223);
}

.cargo-panel Button:focus {
    border-color: rgb(31, 95, 139);
    border-width: 3px;
}

.cargo-panel Button:disabled {
    opacity: 0.4;
}

.cargo-header {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
}

.cargo-title {
    font-size: 24px;
    -unity-font-style: bold;
}

.cargo-close {
    padding: 8px 16px;
}

.cargo-body {
    flex-direction: row;
    flex-wrap: wrap;
}

.cargo-letter {
    flex-grow: 1;
    flex-basis: 260px;
    margin: 0 24px 16px 0;
    padding: 16px;
    border-width: 1px;
    border-color: rgb(214, 198, 166);
    border-radius: 8px;
    background-color: rgb(251, 245, 232);
}

.cargo-heading {
    margin-bottom: 8px;
    font-size: 16px;
    -unity-font-style: bold;
}

.cargo-letter-from,
.cargo-hint,
.good-stock,
.good-stowed {
    color: rgb(107, 92, 69);
}

.cargo-letter-line {
    margin-bottom: 8px;
    padding: 4px 6px;
    border-radius: 4px;
}

.cargo-letter-line.flagged {
    background-color: rgb(255, 225, 184);
    border-left-width: 3px;
    border-color: rgb(138, 59, 18);
}

.cargo-work {
    flex-grow: 2;
    flex-basis: 420px;
}

.cargo-goods {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 12px;
}

.good {
    flex-grow: 1;
    flex-basis: 240px;
    margin: 0 12px 12px 0;
    padding: 12px;
    border-width: 2px;
    border-color: rgb(214, 198, 166);
    border-radius: 8px;
    background-color: rgb(255, 250, 240);
}

.good.selected {
    border-color: rgb(138, 59, 18);
}

.cargo-panel .good-select {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
    padding: 4px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-left;
}

.good-labels {
    margin-left: 10px;
    flex-shrink: 1;
}

.good-name {
    -unity-font-style: bold;
}

.good-swatch {
    width: 22px;
    height: 22px;
    margin-right: 4px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.25);
}

.good-purple-cloth {
    background-color: rgb(107, 42, 110);
}

.good-wine {
    border-radius: 10px;
    background-color: rgb(180, 95, 60);
}

.good-quantity {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.cargo-panel .stepper {
    width: 32px;
    height: 32px;
    font-size: 18px;
}

.quantity-value {
    min-width: 90px;
    -unity-text-align: middle-center;
}

.good-destinations {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.cargo-panel .destination {
    margin: 0 6px 6px 0;
    padding: 4px 10px;
    border-radius: 14px;
    border-color: rgb(214, 198, 166);
    font-size: 13px;
}

.cargo-panel .destination.chosen {
    border-color: rgb(138, 59, 18);
    background-color: rgb(138, 59, 18);
    color: rgb(255, 255, 255);
}

.ship {
    flex-direction: row;
    margin: 8px 0 12px 0;
    padding: 10px;
    border-width: 3px;
    border-color: rgb(111, 82, 54);
    border-radius: 60px;
    background-color: rgb(201, 166, 121);
}

.ship-end {
    width: 48px;
    -unity-text-align: middle-center;
    font-size: 12px;
    color: rgb(74, 56, 38);
}

.cargo-panel .hold-slot {
    flex-grow: 1;
    min-height: 120px;
    margin: 0 4px;
    padding: 10px;
    border-width: 2px;
    border-color: rgb(111, 82, 54);
    border-radius: 8px;
    background-color: rgb(232, 211, 176);
    align-items: flex-start;
    justify-content: flex-start;
    -unity-text-align: upper-left;
}

.cargo-panel .hold-slot:hover {
    background-color: rgb(243, 226, 196);
}

.cargo-panel .hold-slot:disabled {
    opacity: 1;
}

.hold-name {
    -unity-font-style: bold;
}

.hold-location {
    font-size: 11px;
    color: rgb(107, 92, 69);
}

.hold-description {
    font-size: 12px;
}

.hold-contents {
    flex-direction: row;
    margin-top: 4px;
}

.dockworker {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 12px;
    padding: 12px 16px;
    border-left-width: 4px;
    border-color: rgb(138, 59, 18);
    border-radius: 4px;
    background-color: rgb(255, 243, 223);
}

.dockworker-name {
    -unity-font-style: bold;
}

.dockworker-text {
    flex-shrink: 1;
}

.cargo-panel .cargo-send {
    align-self: flex-start;
    padding: 10px 18px;
    border-color: rgb(138, 59, 18);
    background-color: rgb(138, 59, 18);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.cargo-panel .cargo-send:hover {
    background-color: rgb(160, 75, 30);
}

.cargo-summary {
    margin-bottom: 6px;
}

.cargo-note {
    margin-top: 8px;
    padding: 12px 16px;
    border-width: 1px;
    border-color: rgb(214, 198, 166);
    border-radius: 6px;
    font-size: 13px;
    color: rgb(107, 92, 69);
}

.dye-screen {
    background-color: #151116;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

.story-card.dye-card {
    top: 4%;
    right: auto;
    bottom: auto;
    max-width: 58%;
    width: 420px;
}

.story-root {
    align-items: center;
    justify-content: center;
    background-color: #151116;
}

.story-frame {
    background-color: #000000;
    background-size: 100% 100%;
    flex-shrink: 0;
}

.story-controls {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
}

.story-card {
    position: absolute;
    left: 4%;
    right: 4%;
    bottom: 4%;
    padding: 12px 16px;
    background-color: rgba(32, 20, 27, 0.93);
    border-radius: 8px;
    color: #fff1dd;
    font-size: 16px;
}

.story-card Label {
    white-space: normal;
    color: #fff1dd;
}

.story-speaker {
    -unity-font-style: bold;
    font-size: 20px;
}

.story-actions {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.story-actions Button {
    padding: 6px 14px;
    margin-right: 8px;
    background-color: #f5d294;
    color: #2d1a20;
}

.story-actions Button:focus {
    border-color: #b981c1;
}

.story-banner {
    position: absolute;
    left: 4%;
    top: 4%;
    padding: 6px 12px;
    background-color: #321e2e;
    color: #fff1dd;
    border-radius: 6px;
}

.story-hotspot {
    position: absolute;
    margin: 0;
    padding-bottom: 6px;
    background-color: rgba(35, 18, 32, 0);
    border-color: rgba(255, 222, 154, 0);
    border-width: 2px;
    border-radius: 8px;
    -unity-text-align: lower-center;
    -unity-font-style: bold;
    color: #fff1dd;
    -unity-text-outline-color: #281823;
    -unity-text-outline-width: 1px;
}

.story-hotspot:hover, .story-hotspot:focus {
    background-color: rgba(39, 19, 36, 0.22);
    border-color: #ffde9a;
}

.story-teacher {
    position: absolute;
    left: 32%;
    top: 19%;
    width: 27%;
    height: 65%;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

.story-action-icon, .story-pointer {
    width: 32px;
    height: 32px;
    margin-right: 8px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

.story-pointer {
    display: none;
    position: absolute;
    top: 4px;
    right: 4px;
}

.story-hotspot:hover > .story-pointer, .story-hotspot:focus > .story-pointer {
    display: flex;
}

.letter-game {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
}

.letter-parchment {
    position: absolute;
    top: 33%;
    bottom: 28%;
    left: 18%;
    width: 36%;
    color: #54232d;
}

.letter-reference {
    position: absolute;
    top: 8%;
    bottom: 33%;
    left: 67%;
    right: 3%;
    padding: 10px;
    border-radius: 8px;
    background-color: rgba(54, 25, 43, 0.96);
    color: #fff1dd;
}

.letter-reference Label, .letter-bank Label {
    white-space: normal;
}

#letter-reference-title {
    font-size: 19px;
    -unity-font-style: bold;
}

.letter-alphabet, .letter-options {
    flex-direction: row;
    flex-wrap: wrap;
}

.letter-reference-entry {
    flex-direction: row;
    align-items: center;
    margin-right: 6px;
    margin-bottom: 3px;
}

.letter-glyphs {
    flex-direction: row-reverse;
    justify-content: flex-start;
    flex-wrap: wrap;
    font-size: 17px;
}

.letter-glyphs Label {
    flex-shrink: 0;
    padding: 0;
    margin: 0;
    min-width: 2px;
}

.letter-word {
    flex-direction: row-reverse;
    flex-shrink: 0;
    margin-left: 3px;
    padding-left: 2px;
    padding-right: 2px;
}

.letter-glossary-word {
    background-color: #ffe5a8;
    border-bottom-width: 2px;
    border-bottom-color: #723453;
    color: #54203d;
}

.letter-row {
    margin-bottom: 5px;
}

.letter-slot, .letter-tile {
    white-space: normal;
}

.letter-bank {
    position: absolute;
    bottom: 2%;
    left: 3%;
    right: 3%;
    max-height: 30%;
    padding: 6px;
    border-radius: 8px;
    background-color: rgba(54, 25, 43, 0.96);
    color: #fff1dd;
}

.letter-options {
    flex-shrink: 1;
}

.letter-bank Button {
    background-color: #f3d79c;
    color: #351e2b;
    font-size: 12px;
}

.letter-tile {
    width: 24%;
}

.letter-bank .letter-selected, .letter-bank Button:focus {
    background-color: #d6add9;
}

.letter-ghost {
    position: absolute;
    max-width: 40%;
    white-space: normal;
    background-color: #f3d79c;
    color: #351e2b;
    padding: 6px;
}

.letter-popup {
    align-items: center;
    justify-content: center;
    background-color: rgba(21, 13, 24, 0.66);
}

.letter-popup-panel {
    width: 62%;
    max-width: 640px;
    max-height: 90%;
    padding: 12px 16px;
    border-radius: 8px;
    background-color: #36192b;
    color: #fff1dd;
}

.letter-popup-panel Label {
    white-space: normal;
    margin-bottom: 8px;
}

.letter-popup-heading {
    font-size: 22px;
    -unity-font-style: bold;
}

.letter-popup-panel Button {
    align-self: flex-start;
    background-color: #f3d79c;
    color: #351e2b;
}

.letter-popup-panel Button:focus {
    background-color: #d6add9;
}

.letter-help {
    flex-direction: row;
    flex-wrap: wrap;
}

.letter-guide-left, .letter-guide-right {
    justify-content: flex-start;
    padding: 5%;
    background-color: rgba(21, 13, 24, 0.24);
}

.letter-guide-left {
    align-items: flex-start;
}

.letter-guide-right {
    align-items: flex-end;
}

.letter-guide-left .letter-popup-panel, .letter-guide-right .letter-popup-panel {
    width: 42%;
}

.letter-guide-highlight {
    border-width: 2px;
    border-color: #f4c878;
    border-radius: 4px;
}

.letter-popup-panel .letter-glyphs {
    font-size: 26px;
}

/* Highlights toggle (top left of the letter puzzle) and its tip */

.letter-highlight-toggle {
    position: absolute;
    top: 3%;
    left: 3%;
    padding: 6px 12px;
    border-width: 2px;
    border-color: #723453;
    border-radius: 6px;
    background-color: #ffe5a8;
    color: #351e2b;
    font-size: 14px;
    -unity-font-style: bold;
    transition-property: border-color, scale;
    transition-duration: 0.25s;
}

.letter-highlight-toggle:hover {
    background-color: #f3d79c;
}

.letter-highlights-off .letter-highlight-toggle {
    border-color: #8a7380;
    background-color: #d9cbb0;
    color: #5c4a55;
}

.letter-highlights-off .letter-glossary-word {
    background-color: rgba(0, 0, 0, 0);
    border-bottom-width: 0;
    color: #54232d;
}

.letter-tip {
    background-color: rgba(21, 13, 24, 0.55);
}

.letter-tip-panel {
    position: absolute;
    top: 13%;
    left: 3%;
    width: 36%;
    max-width: 420px;
    overflow: visible;
}

.letter-tip-arrow {
    position: absolute;
    top: -8px;
    left: 30px;
    width: 16px;
    height: 16px;
    background-color: #36192b;
    rotate: 45deg;
}

.letter-game .letter-highlight-toggle.letter-tip-target {
    border-width: 3px;
    border-color: #f4c878;
}

.letter-game .letter-highlight-toggle.letter-tip-pulse {
    border-color: #fff1dd;
    scale: 1.08 1.08;
}
