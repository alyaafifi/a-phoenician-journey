/* Styles for the harbor HUD and the cargo screen. Built in code by HarborGame and CargoScreen. */

.harbor-root {
    flex-grow: 1;
}

/* HUD */

.hud {
    position: absolute;
    top: 12px;
    left: 12px;
    max-width: 420px;
    padding: 10px 14px;
    border-radius: 8px;
    background-color: rgba(20, 24, 30, 0.72);
    color: rgb(242, 242, 242);
    font-size: 13px;
}

.hud > Label {
    white-space: normal;
}

.hud-status {
    color: rgb(255, 225, 184);
}

.hud-help {
    margin-top: 6px;
    color: rgb(200, 208, 216);
}

.prompt {
    position: absolute;
    bottom: 32px;
    align-self: center;
    padding: 10px 18px;
    border-radius: 20px;
    background-color: rgba(20, 24, 30, 0.8);
    color: rgb(255, 255, 255);
    font-size: 16px;
}

/* Cargo screen */

.cargo-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background-color: rgba(15, 18, 22, 0.55);
}

.cargo-panel {
    width: 100%;
    max-width: 1024px;
    max-height: 100%;
    padding: 20px 24px;
    border-radius: 12px;
    background-color: rgb(245, 236, 217);
    color: rgb(45, 36, 24);
    font-size: 15px;
}

.cargo-panel Label {
    white-space: normal;
    color: rgb(45, 36, 24);
}

.cargo-panel Button {
    margin: 0;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(45, 36, 24);
    background-color: rgb(255, 255, 255);
    color: rgb(45, 36, 24);
}

.cargo-panel Button:hover {
    background-color: rgb(255, 243, 223);
}

.cargo-panel Button:focus {
    border-color: rgb(31, 95, 139);
    border-width: 3px;
}

.cargo-panel Button:disabled {
    opacity: 0.4;
}

.cargo-header {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
}

.cargo-title {
    font-size: 24px;
    -unity-font-style: bold;
}

.cargo-close {
    padding: 8px 16px;
}

.cargo-body {
    flex-direction: row;
    flex-wrap: wrap;
}

.cargo-letter {
    flex-grow: 1;
    flex-basis: 260px;
    margin: 0 24px 16px 0;
    padding: 16px;
    border-width: 1px;
    border-color: rgb(214, 198, 166);
    border-radius: 8px;
    background-color: rgb(251, 245, 232);
}

.cargo-heading {
    margin-bottom: 8px;
    font-size: 16px;
    -unity-font-style: bold;
}

.cargo-letter-from,
.cargo-hint,
.good-stock,
.good-stowed {
    color: rgb(107, 92, 69);
}

.cargo-letter-line {
    margin-bottom: 8px;
    padding: 4px 6px;
    border-radius: 4px;
}

.cargo-letter-line.flagged {
    background-color: rgb(255, 225, 184);
    border-left-width: 3px;
    border-color: rgb(138, 59, 18);
}

.cargo-work {
    flex-grow: 2;
    flex-basis: 420px;
}

.cargo-goods {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 12px;
}

.good {
    flex-grow: 1;
    flex-basis: 240px;
    margin: 0 12px 12px 0;
    padding: 12px;
    border-width: 2px;
    border-color: rgb(214, 198, 166);
    border-radius: 8px;
    background-color: rgb(255, 250, 240);
}

.good.selected {
    border-color: rgb(138, 59, 18);
}

.cargo-panel .good-select {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
    padding: 4px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-left;
}

.good-labels {
    margin-left: 10px;
    flex-shrink: 1;
}

.good-name {
    -unity-font-style: bold;
}

.good-swatch {
    width: 22px;
    height: 22px;
    margin-right: 4px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.25);
}

.good-purple-cloth {
    background-color: rgb(107, 42, 110);
}

.good-wine {
    border-radius: 10px;
    background-color: rgb(180, 95, 60);
}

.good-quantity {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.cargo-panel .stepper {
    width: 32px;
    height: 32px;
    font-size: 18px;
}

.quantity-value {
    min-width: 90px;
    -unity-text-align: middle-center;
}

.good-destinations {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.cargo-panel .destination {
    margin: 0 6px 6px 0;
    padding: 4px 10px;
    border-radius: 14px;
    border-color: rgb(214, 198, 166);
    font-size: 13px;
}

.cargo-panel .destination.chosen {
    border-color: rgb(138, 59, 18);
    background-color: rgb(138, 59, 18);
    color: rgb(255, 255, 255);
}

.ship {
    flex-direction: row;
    margin: 8px 0 12px 0;
    padding: 10px;
    border-width: 3px;
    border-color: rgb(111, 82, 54);
    border-radius: 60px;
    background-color: rgb(201, 166, 121);
}

.ship-end {
    width: 48px;
    -unity-text-align: middle-center;
    font-size: 12px;
    color: rgb(74, 56, 38);
}

.cargo-panel .hold-slot {
    flex-grow: 1;
    min-height: 120px;
    margin: 0 4px;
    padding: 10px;
    border-width: 2px;
    border-color: rgb(111, 82, 54);
    border-radius: 8px;
    background-color: rgb(232, 211, 176);
    align-items: flex-start;
    justify-content: flex-start;
    -unity-text-align: upper-left;
}

.cargo-panel .hold-slot:hover {
    background-color: rgb(243, 226, 196);
}

.cargo-panel .hold-slot:disabled {
    opacity: 1;
}

.hold-name {
    -unity-font-style: bold;
}

.hold-location {
    font-size: 11px;
    color: rgb(107, 92, 69);
}

.hold-description {
    font-size: 12px;
}

.hold-contents {
    flex-direction: row;
    margin-top: 4px;
}

.dockworker {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 12px;
    padding: 12px 16px;
    border-left-width: 4px;
    border-color: rgb(138, 59, 18);
    border-radius: 4px;
    background-color: rgb(255, 243, 223);
}

.dockworker-name {
    -unity-font-style: bold;
}

.dockworker-text {
    flex-shrink: 1;
}

.cargo-panel .cargo-send {
    align-self: flex-start;
    padding: 10px 18px;
    border-color: rgb(138, 59, 18);
    background-color: rgb(138, 59, 18);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.cargo-panel .cargo-send:hover {
    background-color: rgb(160, 75, 30);
}

.cargo-summary {
    margin-bottom: 6px;
}

.cargo-note {
    margin-top: 8px;
    padding: 12px 16px;
    border-width: 1px;
    border-color: rgb(214, 198, 166);
    border-radius: 6px;
    font-size: 13px;
    color: rgb(107, 92, 69);
}
